# Copy to .env or export in your shell. Every value is optional.

# --- API (see backend/docs/api_documentation.md) ---
# Browser origins allowed to call the API, comma separated. Empty = no CORS headers.
# API_CORS_ORIGINS=http://localhost:5173
# API_HOST=127.0.0.1
# API_PORT=8000
# API_LOG_LEVEL=INFO
# API_ENABLE_DOCS=true
# API_DIALOGUE_TIMEOUT_S=150      # hard cap for one NPC reply
# API_LLM_CONCURRENCY=2           # simultaneous LLM generations
# API_INTERVIEW_MIN_TURNS=1       # NPC replies needed before an interview can be completed
# API_MAX_BODY_BYTES=16384
# API_CASE_IDS=case_001           # default: every case found in backend/case_data
# API_CASE_DATA_ROOT=

# --- Local LLM (read by src/llm/engine_runner.py) ---
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# LLM_CONNECT_TIMEOUT_S=5
# LLM_READ_TIMEOUT_S=10
# LLM_TOTAL_DEADLINE_S=30
# LLM_COLD_START_TIMEOUT_S=120
